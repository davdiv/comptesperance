# Local development defaults. Copy to .env for `npm run dev`.
DATA_REPO_PATH=./data
CACHE_DB_PATH=./.data/comptes.sqlite
AUTH_DISABLED=true
AUTH_READWRITE_GROUP=comptes-readwrite
AUTH_READONLY_GROUP=comptes-readonly
MAX_EVIDENCE_BYTES=26214400

# docker-compose only
AUTHELIA_SESSION_SECRET=change-me-local-only
