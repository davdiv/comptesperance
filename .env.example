# Local development defaults. Copy to .env for `npm run dev`.
DATA_REPO_PATH=./data
CACHE_DB_PATH=./.data/comptes.sqlite
AUTH_DISABLED=true
AUTH_LOGOUT_URL=https://auth.comptes.localhost:8443/logout
AUTH_READWRITE_GROUP=comptes-readwrite
AUTH_READONLY_GROUP=comptes-readonly
MAX_EVIDENCE_BYTES=26214400
BODY_SIZE_LIMIT=100M

# docker-compose only
AUTHELIA_SESSION_SECRET=change-me-local-only
AUTHELIA_JWT_SECRET=change-me-local-only
AUTHELIA_STORAGE_ENCRYPTION_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
